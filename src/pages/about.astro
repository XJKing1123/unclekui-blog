---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ArrowUpRight, BookOpen, Mail, Search } from '@lucide/astro';
import { SITE } from '../config/site';
import { getPublishedPosts } from '../lib/content';

const posts = await getPublishedPosts();
const principles = [
  '稳定公开契约与特定版本内部实现分开描述。',
  '性能结论以目标设备上的 Profile 或 Release 测量为依据。',
  '示例覆盖异常、取消、竞态、资源释放和跨平台差异。',
  '发现错误或版本变化后修订正文，并更新文章日期。',
];
---

<BaseLayout title="关于" description={`关于 ${SITE.author.name} 与奎叔技术笔记的内容原则、技术方向和联系方式。`}>
  <header class="page-header about-header">
    <div class="container">
      <p class="eyebrow">About</p>
      <h1>关于本站</h1>
      <p>记录可验证、可复现、能进入真实工程现场的技术结论。</p>
    </div>
  </header>

  <div class="container about-page">
    <div class="about-layout">
      <aside class="about-profile" aria-label="作者信息">
        <div class="about-identity">
          <img src={SITE.author.avatar} alt={`${SITE.author.name} 的头像`} width="112" height="112" />
          <div>
            <p class="eyebrow">Author</p>
            <h2>{SITE.author.name}</h2>
            <p class="about-role">{SITE.author.role}</p>
          </div>
        </div>
        <p class="about-bio">{SITE.author.bio}</p>
        <dl class="about-stats">
          <div><dt>{posts.length}</dt><dd>已发布文章</dd></div>
          <div><dt>4</dt><dd>技术方向</dd></div>
        </dl>
        <a class="about-email" href={`mailto:${SITE.author.email}`}><Mail size={16} aria-hidden="true" /><span>{SITE.author.email}</span></a>
      </aside>

      <div class="about-main">
        <section class="about-section about-principles-section">
          <p class="eyebrow">Editorial Standard</p>
          <h2>写作原则</h2>
          <p class="about-lead">本站关注 Flutter、iOS、React、Web3 与软件工程实践。文章不仅说明 API 如何使用，也会交代核心对象、执行流程、生命周期、边界条件与方案代价。</p>
          <ol class="about-principles">
            {principles.map((principle, index) => (
              <li><span>{String(index + 1).padStart(2, '0')}</span><p>{principle}</p></li>
            ))}
          </ol>
        </section>

        <section class="about-section about-start">
          <p class="eyebrow">Explore</p>
          <h2>从哪里开始</h2>
          <div class="about-links">
            <a href="/knowledge-map/">
              <span class="about-link-icon"><BookOpen size={18} aria-hidden="true" /></span>
              <span><strong>知识地图</strong><small>按前置关系建立学习路径</small></span>
              <ArrowUpRight size={16} aria-hidden="true" />
            </a>
            <a href="/search/">
              <span class="about-link-icon"><Search size={18} aria-hidden="true" /></span>
              <span><strong>全文搜索</strong><small>定位具体问题和技术概念</small></span>
              <ArrowUpRight size={16} aria-hidden="true" />
            </a>
            <a href={`mailto:${SITE.author.email}`}>
              <span class="about-link-icon"><Mail size={18} aria-hidden="true" /></span>
              <span><strong>勘误与联系</strong><small>提供复现环境与版本信息</small></span>
              <ArrowUpRight size={16} aria-hidden="true" />
            </a>
          </div>
        </section>

        <aside class="about-note"><strong>引用说明</strong><p>转载或引用时请保留作者与原文链接；发现技术错误，欢迎通过邮件提供复现环境和相关版本。</p></aside>
      </div>
    </div>
  </div>
</BaseLayout>
