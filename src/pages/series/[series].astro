---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { COLUMNS, type ColumnKey } from '../../config/site';
import { getColumnKey, getPublishedPosts, postHref } from '../../lib/content';

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  return Object.keys(COLUMNS).map((series) => ({
    params: { series },
    props: { posts: posts.filter((post) => getColumnKey(post.data.series) === series).sort((a, b) => a.data.order - b.data.order) },
  }));
}) satisfies GetStaticPaths;

const { series } = Astro.params;
const { posts } = Astro.props;
const meta = COLUMNS[series as ColumnKey];
---
<BaseLayout title={meta.name} description={meta.description}>
  <header class="page-header"><div class="container"><p class="eyebrow">Series · {posts.length} articles</p><h1>{meta.name}</h1><p>{meta.description}</p></div></header>
  <div class="container post-list">
    {posts.map((post, index) => (
      <article class="post-row post-row--series"><span class="series-order">{String(index + 1).padStart(2, '0')}</span><h2><a href={postHref(post.data.slug)}>{post.data.title}</a></h2></article>
    ))}
  </div>
</BaseLayout>
