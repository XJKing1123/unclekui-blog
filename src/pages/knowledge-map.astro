---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ExternalLink, Minus, Plus, RotateCcw, Search, X } from '@lucide/astro';
import { COLUMNS, SERIES, type SeriesKey } from '../config/site';
import { getPublishedPosts } from '../lib/content';
import { buildKnowledgeGraph } from '../lib/knowledge-graph';

const posts = await getPublishedPosts();
const graph = buildKnowledgeGraph(posts);
const columns = [...new Set(graph.nodes.map((node) => node.column))];
const articleNodes = graph.nodes.filter((node) => node.type === 'article');
const graphJson = JSON.stringify(graph).replace(/</g, '\\u003c');

const postsBySeries = new Map<string, typeof articleNodes>();
articleNodes.forEach((node) => {
  const key = node.series ?? 'other';
  postsBySeries.set(key, [...(postsBySeries.get(key) ?? []), node]);
});
postsBySeries.forEach((nodes) => nodes.sort((a, b) => (a.order ?? 0) - (b.order ?? 0) || a.label.localeCompare(b.label)));
---

<BaseLayout title="知识地图" description="在三维关系图中探索 Flutter、iOS、React 与 Web3 的学习路径、前置知识和工程主题。">
  <section class="knowledge-explorer" data-knowledge-explorer>
    <div class="knowledge-toolbar container" aria-label="知识地图工具栏">
      <div class="knowledge-heading">
        <p class="eyebrow">Learning Graph</p>
        <h1>知识地图</h1>
        <p>{articleNodes.length} 篇文章，沿学习顺序与前置关系连接。</p>
      </div>

      <div class="knowledge-controls">
        <div class="knowledge-search">
          <Search size={16} aria-hidden="true" />
          <label class="sr-only" for="knowledge-search">搜索文章或系列</label>
          <input id="knowledge-search" type="search" placeholder="搜索文章或系列" autocomplete="off" list="knowledge-search-options" />
          <datalist id="knowledge-search-options">
            {graph.nodes.map((node) => <option value={node.label} />)}
          </datalist>
        </div>
        <label class="sr-only" for="knowledge-column-filter">筛选技术栏目</label>
        <select id="knowledge-column-filter">
          <option value="all">全部栏目</option>
          {columns.map((column) => <option value={column}>{COLUMNS[column].name}</option>)}
        </select>
        <div class="view-switch" role="group" aria-label="视图模式">
          <button type="button" data-view="graph" aria-pressed="true">3D</button>
          <button type="button" data-view="list" aria-pressed="false">列表</button>
        </div>
        <div class="map-icon-controls">
          <button type="button" data-action="zoom-in" aria-label="放大" title="放大"><Plus size={17} /></button>
          <button type="button" data-action="zoom-out" aria-label="缩小" title="缩小"><Minus size={17} /></button>
          <button type="button" data-action="reset" aria-label="重置视角" title="重置视角"><RotateCcw size={16} /></button>
        </div>
      </div>
    </div>

    <div class="knowledge-stage-shell" data-graph-view>
      <div id="knowledge-graph" class="knowledge-graph" role="application" aria-label="三维知识关系图"></div>
      <div class="graph-status" data-graph-status>正在构建知识关系图…</div>
      <div class="graph-legend" aria-label="图例">
        {columns.map((column) => <span><i data-column={column}></i>{COLUMNS[column].name.replace(' 工程实践', '')}</span>)}
        <span><b class="legend-line legend-line--solid"></b>学习顺序</span>
        <span><b class="legend-line legend-line--dashed"></b>前置关系</span>
      </div>
      <div class="selected-node-label" data-node-label hidden></div>

      <aside class="knowledge-detail" data-knowledge-detail aria-live="polite" hidden>
        <button class="detail-close" type="button" data-detail-close aria-label="关闭详情" title="关闭"><X size={17} /></button>
        <p class="eyebrow" data-detail-kind></p>
        <h2 data-detail-title></h2>
        <div class="detail-meta" data-detail-meta></div>
        <p data-detail-description></p>
        <dl class="detail-relations">
          <div><dt>前置内容</dt><dd data-detail-before>无</dd></div>
          <div><dt>后续内容</dt><dd data-detail-after>无</dd></div>
        </dl>
        <a class="detail-link" data-detail-link href="/">查看内容 <ExternalLink size={15} aria-hidden="true" /></a>
      </aside>
    </div>

    <div class="knowledge-list container" data-list-view hidden>
      {columns.map((column) => {
        const seriesKeys = [...postsBySeries.keys()].filter((series) => graph.nodes.some((node) => node.id === `series:${series}` && node.column === column));
        return (
          <section class="knowledge-list-column" data-list-column={column}>
            <div class="knowledge-list-heading">
              <p class="eyebrow">{column} Path</p>
              <h2>{COLUMNS[column].name}</h2>
              <p>{COLUMNS[column].description}</p>
            </div>
            <div class="knowledge-list-series">
              {seriesKeys.map((series) => (
                <section>
                  <h3>{SERIES[series as SeriesKey]?.name ?? series}</h3>
                  <ol>
                    {(postsBySeries.get(series) ?? []).map((node) => (
                      <li data-search-text={`${node.label} ${node.description ?? ''}`.toLowerCase()}>
                        <span>{String(node.order ?? 0).padStart(2, '0')}</span>
                        <div><a href={node.href}>{node.label}</a><p>{node.description}</p></div>
                      </li>
                    ))}
                  </ol>
                </section>
              ))}
            </div>
          </section>
        );
      })}
    </div>
  </section>

  <script is:inline id="knowledge-graph-data" type="application/json" set:html={graphJson}></script>
  <script>
    import { initKnowledgeGraph } from '../scripts/knowledge-graph';
    initKnowledgeGraph();
  </script>
</BaseLayout>
