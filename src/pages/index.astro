---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import TagChip from '../components/TagChip.astro';
import { Mail } from '@lucide/astro';
import { COLUMNS, SITE } from '../config/site';
import { getColumnKey, getPublishedPosts } from '../lib/content';

const posts = await getPublishedPosts();
const latest = posts.slice(0, 6);
const tagCounts = new Map<string, number>();
posts.forEach((post) => post.data.tags.forEach((tag) => tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1)));
const popularTags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 10);
const seriesCounts = new Map<string, number>();
posts.forEach((post) => {
  const column = getColumnKey(post.data.series);
  seriesCounts.set(column, (seriesCounts.get(column) ?? 0) + 1);
});
---

<BaseLayout>
  <section class="home-intro">
    <div class="container home-grid">
      <div>
        <p class="eyebrow">Software Engineering Journal</p>
        <h1 class="home-title">把框架原理写进工程现场</h1>
        <p class="home-lead">从运行机制、性能测量到架构与安全，用可验证的代码和因果链记录 Flutter、iOS、React 与 Web3 实践。</p>
        <div class="home-metrics" aria-label="内容概览">
          <div class="home-metric"><strong>{posts.length}</strong><span>深度文章</span></div>
          <div class="home-metric"><strong>{Object.keys(COLUMNS).length}</strong><span>技术专栏</span></div>
          <div class="home-metric"><strong>{tagCounts.size}</strong><span>知识标签</span></div>
        </div>
      </div>
      <aside class="author-panel">
        <div class="author-row">
          <img class="author-avatar" src={SITE.author.avatar} alt={`${SITE.author.name} 的头像`} width="64" height="64" />
          <div><h2>{SITE.author.name}</h2><p>{SITE.author.role}</p></div>
        </div>
        <p class="author-bio">{SITE.author.bio}</p>
        <a class="author-email" href={`mailto:${SITE.author.email}`}><Mail size={15} aria-hidden="true" />{SITE.author.email}</a>
      </aside>
    </div>
  </section>

  <section class="container home-section">
    <div class="section-heading"><h2>最新文章</h2><a href="/posts/">查看全部</a></div>
    <div class="post-grid">{latest.map((post) => <PostCard post={post} tagCounts={tagCounts} />)}</div>
  </section>

  <section class="container home-section">
    <div class="section-heading"><h2>技术专栏</h2><a href="/series/">按顺序阅读</a></div>
    <div class="series-grid">
      {Object.entries(COLUMNS).map(([key, series]) => (
        <a class="series-card" href={`/series/${key}/`}>
          <div class="eyebrow">Series</div><h3>{series.name}</h3><p>{series.description}</p>
          <span class="series-count">{seriesCounts.get(key) ?? 0} 篇文章</span>
        </a>
      ))}
    </div>
  </section>

  <section class="container home-section">
    <div class="section-heading"><h2>热门标签</h2><a href="/tags/">全部标签</a></div>
    <div class="tag-cloud">{popularTags.map(([tag, count]) => <TagChip tag={tag} count={count} />)}</div>
  </section>
</BaseLayout>
