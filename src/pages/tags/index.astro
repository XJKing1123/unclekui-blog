---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagChip from '../../components/TagChip.astro';
import { buildTagCounts, getPublishedPosts, isIndexableTag } from '../../lib/content';
const posts = await getPublishedPosts();
const tags = buildTagCounts(posts);
const sorted = [...tags.entries()].filter(([, count]) => isIndexableTag(count)).sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'zh-CN'));
---
<BaseLayout title="标签" description="按核心技术主题浏览 Flutter、iOS、React 与 Web3 文章。">
  <header class="page-header"><div class="container"><p class="eyebrow">Topics</p><h1>标签</h1><p>从具体技术概念进入相关文章。</p></div></header>
  <div class="container tag-cloud">{sorted.map(([tag, count]) => <TagChip tag={tag} count={count} />)}</div>
</BaseLayout>
