---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagChip from '../../components/TagChip.astro';
import { getPublishedPosts } from '../../lib/content';
const posts = await getPublishedPosts();
const tags = new Map<string, number>();
posts.forEach((post) => post.data.tags.forEach((tag) => tags.set(tag, (tags.get(tag) ?? 0) + 1)));
const sorted = [...tags.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'zh-CN'));
---
<BaseLayout title="标签" description="按技术标签浏览 Flutter 文章。">
  <header class="page-header"><div class="container"><p class="eyebrow">Topics</p><h1>标签</h1><p>从具体技术概念进入相关文章。</p></div></header>
  <div class="container tag-cloud">{sorted.map(([tag, count]) => <TagChip tag={tag} count={count} />)}</div>
</BaseLayout>
