---
import { Menu, Search, Moon, Sun, Monitor, Palette } from '@lucide/astro';
import { SITE } from '../config/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  noCanonical?: boolean;
  type?: 'website' | 'article';
  publishedTime?: Date;
  updatedTime?: Date;
  robots?: 'index,follow' | 'noindex,follow';
}

const {
  title,
  description = SITE.description,
  image = '/og-default.png',
  canonical,
  noCanonical = false,
  type = 'website',
  publishedTime,
  updatedTime,
  robots = 'index,follow',
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE.shortTitle}` : SITE.title;
const canonicalUrl = noCanonical ? undefined : new URL(canonical || Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
const currentPath = Astro.url.pathname;
const isCurrentNavItem = (href: string) => href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(href);
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.title,
  description: SITE.description,
  url: new URL('/', Astro.site).toString(),
  inLanguage: 'zh-CN',
  author: {
    '@type': 'Person',
    name: SITE.author.name,
    url: new URL('/about/', Astro.site).toString(),
  },
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#10a37f" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {updatedTime && <meta property="article:modified_time" content={updatedTime.toISOString()} />}
    <title>{pageTitle}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('theme') || 'system';
        const dark = saved === 'dark' || (saved === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        document.documentElement.dataset.themePreference = saved;
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" aria-label={`${SITE.title} 首页`}>
          <span class="brand-mark" aria-hidden="true">奎</span>
          <span>{SITE.shortTitle}</span>
        </a>
        <nav class="main-nav" id="main-nav" aria-label="主导航">
          {SITE.nav.map((item) => (
            <a href={item.href} aria-current={isCurrentNavItem(item.href) ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
        <div class="header-actions">
          <a class="icon-link" href="/search/" aria-label="搜索文章" title="搜索">
            <Search size={17} stroke-width={1.8} />
          </a>
          <div class="theme-picker">
            <button class="theme-button" id="theme-trigger" type="button" aria-label="选择主题" title="主题" aria-expanded="false">
              <Palette size={17} stroke-width={1.8} />
            </button>
            <div class="theme-menu" id="theme-menu" role="radiogroup" aria-label="主题模式">
              <button class="theme-option" type="button" role="radio" data-theme-value="light">
                <Sun size={16} /> 浅色
              </button>
              <button class="theme-option" type="button" role="radio" data-theme-value="dark">
                <Moon size={16} /> 深色
              </button>
              <button class="theme-option" type="button" role="radio" data-theme-value="system">
                <Monitor size={16} /> 跟随系统
              </button>
            </div>
          </div>
          <button class="nav-toggle" id="nav-toggle" type="button" aria-label="打开导航" aria-controls="main-nav" aria-expanded="false">
            <Menu size={19} stroke-width={1.8} />
          </button>
        </div>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <div>© {new Date().getFullYear()} {SITE.author.name} · 用事实、代码与测量记录工程实践</div>
        <nav class="footer-nav" aria-label="页脚导航">
          <a href="/tags/">标签</a>
          <a href="/about/">关于</a>
          <a href={`mailto:${SITE.author.email}`}>联系</a>
        </nav>
      </div>
    </footer>
    <script>
      const trigger = document.querySelector<HTMLButtonElement>('#theme-trigger');
      const menu = document.querySelector<HTMLElement>('#theme-menu');
      const options = document.querySelectorAll<HTMLButtonElement>('[data-theme-value]');
      const media = matchMedia('(prefers-color-scheme: dark)');
      const navToggle = document.querySelector<HTMLButtonElement>('#nav-toggle');
      const mainNav = document.querySelector<HTMLElement>('#main-nav');

      function applyTheme(value: string) {
        const previousTheme = document.documentElement.dataset.theme;
        const dark = value === 'dark' || (value === 'system' && media.matches);
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        document.documentElement.dataset.themePreference = value;
        localStorage.setItem('theme', value);
        options.forEach((option) => option.setAttribute('aria-checked', String(option.dataset.themeValue === value)));
        if (previousTheme && previousTheme !== document.documentElement.dataset.theme) {
          dispatchEvent(new CustomEvent('site-theme-change'));
        }
      }

      trigger?.addEventListener('click', () => {
        const open = menu?.dataset.open !== 'true';
        if (menu) menu.dataset.open = String(open);
        trigger.setAttribute('aria-expanded', String(open));
      });

      options.forEach((option) => option.addEventListener('click', () => {
        applyTheme(option.dataset.themeValue || 'system');
        if (menu) menu.dataset.open = 'false';
        trigger?.setAttribute('aria-expanded', 'false');
      }));

      media.addEventListener('change', () => {
        if ((localStorage.getItem('theme') || 'system') === 'system') applyTheme('system');
      });

      document.addEventListener('click', (event) => {
        if (!menu?.contains(event.target as Node) && !trigger?.contains(event.target as Node)) {
          menu?.setAttribute('data-open', 'false');
          trigger?.setAttribute('aria-expanded', 'false');
        }
        if (!mainNav?.contains(event.target as Node) && !navToggle?.contains(event.target as Node)) {
          mainNav?.removeAttribute('data-open');
          navToggle?.setAttribute('aria-expanded', 'false');
          navToggle?.setAttribute('aria-label', '打开导航');
        }
      });

      navToggle?.addEventListener('click', () => {
        const open = mainNav?.dataset.open !== 'true';
        mainNav?.setAttribute('data-open', String(open));
        navToggle.setAttribute('aria-expanded', String(open));
        navToggle.setAttribute('aria-label', open ? '关闭导航' : '打开导航');
      });

      applyTheme(localStorage.getItem('theme') || 'system');
    </script>
  </body>
</html>
